# Environment Variables for Direct Care Indy Site
# Copy this file to .env.local for local development
# For Vercel deployment, add these variables in the Vercel dashboard

# Site URL (defaults to Vercel demo URL when unset)
NEXT_PUBLIC_SITE_URL=https://direct-care-indy-site.vercel.app
# Set to "demo" to force noindex behavior on non-Vercel hosts
NEXT_PUBLIC_SITE_STATUS=demo

# Lead Notification System
# NOTIFICATION_EMAIL is the inbox for lead alerts when a delivery method is active.
NOTIFICATION_EMAIL=info@directcareindy.com

# Active delivery method (choose one when ready to wire notifications):
# Resend is the only method implemented in app/api/leads/route.ts today.
RESEND_API_KEY=your_resend_api_key_here

# --- Not yet active (do not copy into .env.local until wired in code) ---
# LEAD_WEBHOOK_URL=https://your-webhook-url.com/leads
# SENDGRID_API_KEY=your_sendgrid_api_key_here

# Cloudinary media (defaults to djhqowk67 when unset)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=djhqowk67

# Stock image fetching (scripts/fetch-page-slot-images.js, fetch-stock-images-refined.js)
PEXELS_API_KEY=your_pexels_api_key_here
# UNSPLASH_ACCESS_KEY=your_unsplash_key_here
# PIXABAY_API_KEY=your_pixabay_key_here

# Air Quality Widget (Optional - enhances Indy Breath-Easy widget)
NEXT_PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Analytics (optional — leave empty to disable GTM locally)
NEXT_PUBLIC_GTM_ID=

# Claims approval gates
# Set to true only after HSA/FSA language has been approved.
NEXT_PUBLIC_HSA_APPROVED=false

# Quiz scheduler URLs (optional — leave empty to use /contact quiz fallbacks)
# Source of truth: lib/dpc-fit-quiz.ts → getDpcQuizScheduleLink()
# When unset, each key falls back to /contact?source=quiz&intent=<intent>
NEXT_PUBLIC_SCHEDULE_INDIVIDUAL_INTRO=
NEXT_PUBLIC_SCHEDULE_FAMILY_INTRO=
NEXT_PUBLIC_SCHEDULE_SENIOR_INTRO=
NEXT_PUBLIC_SCHEDULE_SMALL_EMPLOYER_INTRO=
NEXT_PUBLIC_SCHEDULE_EMPLOYER_INTRO=
NEXT_PUBLIC_SCHEDULE_EMPLOYER_STRATEGY=
NEXT_PUBLIC_SCHEDULE_BROKER_CONVERSATION=

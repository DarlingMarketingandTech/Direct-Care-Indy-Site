# Environment Variables for Direct Care Indy Site
# Copy this file to .env.local for local development
# For Vercel deployment, add these variables in the Vercel dashboard

# Site URL (defaults to Vercel demo URL when unset)
NEXT_PUBLIC_SITE_URL=https://direct-care-indy-site.vercel.app
# Set to "demo" to force noindex behavior on non-Vercel hosts
NEXT_PUBLIC_SITE_STATUS=demo

# Lead Notification System (Required)
NOTIFICATION_EMAIL=info@directcareindy.com

# Choose ONE of the following notification methods:
# Option 1: Webhook (for Zapier/Make.com integration)
LEAD_WEBHOOK_URL=https://your-webhook-url.com/leads

# Option 2: Resend API (for email notifications)
RESEND_API_KEY=your_resend_api_key_here

# Option 3: SendGrid API (for email notifications)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Air Quality Widget (Optional - enhances Indy Breath-Easy widget)
NEXT_PUBLIC_OPENWEATHER_API_KEY=ea2669bff97a26ccf6139c285f183f46

# Claims approval gates
# Set to true only after HSA/FSA language has been approved.
NEXT_PUBLIC_HSA_APPROVED=false
